<Window x:Class="OmarchyBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="12,0">
        <StackPanel x:Name="LeftPanel" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <StackPanel x:Name="CenterPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <StackPanel x:Name="RightPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
</Window>
